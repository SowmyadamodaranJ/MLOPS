# ============================================================
# .env.example — Environment Configuration Template
# Smart Factory Predictive Maintenance Platform
#
# HOW TO USE:
#   cp .env.example .env
#   # Then edit .env with your real values
#
# SECURITY:
#   - Never commit .env to git (it's in .gitignore)
#   - Rotate FLASK_SECRET_KEY for every environment
#   - Use a secrets manager (AWS Secrets Manager, Vault) in production
# ============================================================

# ── Application Identity ─────────────────────────────────────
APP_NAME="Smart Factory Predictive Maintenance"
APP_VERSION=2.0.0
APP_ENV=production              # production | development

# ── Build Metadata (set by CI/CD pipeline) ──────────────────
BUILD_DATE=unknown
GIT_SHA=unknown

# ── Security — CHANGE THIS! ──────────────────────────────────
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE-ME-generate-a-secure-random-secret-key-here

# ── Backend Configuration ────────────────────────────────────
BACKEND_PORT=5000
FLASK_ENV=production
FLASK_DEBUG=0                   # NEVER set to 1 in production

# Gunicorn worker tuning
# Formula: (2 × vCPU_count) + 1
WEB_CONCURRENCY=5
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120            # seconds — allow for SHAP computation

# CORS — comma-separated list of allowed frontend origins
# In Docker Compose, the Nginx proxy handles this; set to your domain(s)
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=80

# VITE_API_URL: Only set this if NOT using Nginx reverse proxy.
# Leave empty when using docker-compose (Nginx proxies /api → backend).
VITE_API_URL=

# ── Database ─────────────────────────────────────────────────
DB_PATH=/app/data/predictions.db
DATABASE_PATH=data/predictions.db
DB_TIMEOUT_SECONDS=15.0

# ── MLflow Tracking Server ───────────────────────────────────
MLFLOW_PORT=5001
# In Docker Compose, backend uses the internal service hostname:
MLFLOW_TRACKING_URI=http://mlflow:5001
# For local development (outside Docker):
# MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=SmartFactory_PredictiveMaintenance
MLFLOW_DB_PATH=mlflow.db
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/data/mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_HOST=0.0.0.0

# Install cloud storage SDKs in MLflow container (boto3, azure, gcp)
# Set to true only if using S3/Azure Blob/GCS as artifact store
INSTALL_CLOUD_DEPS=false

# ── Model Registry & Artifacts ───────────────────────────────
MODELS_DIR=models/saved_models
METRICS_DIR=reports/metrics
EVIDENTLY_REPORTS_DIR=reports/evidently

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=/app/logs

# ── Monitoring & Alert Thresholds ────────────────────────────
ALERT_MEMORY_THRESHOLD_PCT=85.0
ALERT_LATENCY_THRESHOLD_MS=150.0
ALERT_FAILURE_RATE_THRESHOLD_PCT=5.0

# ── Backup Configuration ─────────────────────────────────────
BACKUP_RETENTION_DAYS=7         # Number of backup archives to keep
BACKUP_DIR=backups
